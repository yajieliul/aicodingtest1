{
  "name": "aicodingtest1",
  "version": "1.0.0",
  "description": "一个基于 Canvas 的贪吃蛇 Web 小游戏（支持 Web 与 Electron 桌面版）",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:desktop": "npm run build && electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:portable": "electron-builder --win portable"
  },
  "keywords": [
    "snake",
    "game",
    "canvas",
    "vite"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
